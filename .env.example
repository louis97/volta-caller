PORT=3001
# mock = sin credenciales, todo simulado (default). live = llamadas reales.
VOLTA_MODE=mock

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número Twilio desde el que se marca, formato E.164 (ej. +14155551234)
TWILIO_FROM_NUMBER=
# Tope duro por llamada saliente (0 = no enviar el parametro).
# Las cuentas trial RECHAZAN este parametro: dejar en 0 hasta upgradear.
CALL_TIME_LIMIT_SECONDS=0
# Grabacion dual-channel: necesaria para anclar compromisos al audio.
# Las cuentas trial la rechazan. Poner true despues de upgradear.
TWILIO_RECORD_CALLS=false

# --- OpenAI Realtime ---
OPENAI_API_KEY=
# Usar el tier mini mientras se itera; el modelo completo solo en ensayos y demo.
OPENAI_REALTIME_MODEL=gpt-realtime

# --- Túnel público (ngrok http 3001) ---
# Twilio necesita alcanzar estas URLs desde internet.
PUBLIC_BASE_URL=https://xxxx.ngrok.app
PUBLIC_WS_URL=wss://xxxx.ngrok.app

# Teléfono al que se escala una llamada en vivo, formato E.164
SUPERVISOR_PHONE=

NEXT_PUBLIC_API_URL=http://localhost:3001
