PORT=3001
# mock = sin credenciales, todo simulado (default). live = llamadas reales.
VOLTA_MODE=mock
VOLTA_QUOTE_EXTRACTION_MODEL=gpt-5-mini
# --- Twilio (capa de voz) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Numero Twilio desde el que se marca, formato E.164 (ej. +14155551234)
TWILIO_FROM_NUMBER=
# Tope duro por llamada saliente (0 = no enviar el parametro).
# Las cuentas trial RECHAZAN este parametro: dejar en 0 hasta upgradear.
CALL_TIME_LIMIT_SECONDS=90
# Grabacion dual-channel: necesaria para anclar compromisos al audio.
# Las cuentas trial la rechazan.
TWILIO_RECORD_CALLS=true
# Telefono al que se escala una llamada en vivo, formato E.164
SUPERVISOR_PHONE=

# --- OpenAI ---
# OPENAI_API_KEY=
# Voz en tiempo real. Usar el tier mini mientras se itera.
OPENAI_REALTIME_MODEL=gpt-realtime
# Modelo del copiloto operacional (texto)
VOLTA_COPILOT_MODEL=gpt-5
OPENAI_REALTIME_VOICE=marin

# --- Turno de conversacion ---
# Los valores correctos son una propiedad de la SALA, no del codigo.
# Sala ruidosa: subir threshold y usar far_field.
# threshold: 0.5 = default OpenAI (muy sensible) | 0.7-0.9 = sala ruidosa
REALTIME_VAD_THRESHOLD=0.8
# Silencio antes de dar por terminado el turno del interlocutor
REALTIME_VAD_SILENCE_MS=450
REALTIME_VAD_PREFIX_MS=300
# near_field = telefono al oido | far_field = altavoz o sala | none = desactivar
REALTIME_NOISE_REDUCTION=far_field
# server_vad = por volumen | semantic_vad = el modelo juzga si terminaste la frase
REALTIME_TURN_DETECTION=server_vad
REALTIME_VAD_EAGERNESS=low

# --- Tunel publico (ngrok http 3001) ---
# Twilio necesita alcanzar estas URLs desde internet. Mismo host, distinto esquema.
PUBLIC_BASE_URL=https://xxxx.ngrok-free.dev
PUBLIC_WS_URL=wss://xxxx.ngrok-free.dev

# --- Persistencia ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://volta:volta@localhost:5432/volta
VOLTA_DEFAULT_ORGANIZATION_ID=textiles-pacifico
VOLTA_INTERNAL_API_KEY=replace-with-at-least-16-characters

# --- WhatsApp (Kapso) ---
# API key del proyecto de Kapso, ID interno del número de WhatsApp y secreto
# elegido al crear el webhook. Los tres son obligatorios para habilitar el canal.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Despliegue (Render API + Vercel frontend) ---
# En Vercel (server-only): URL pública del servicio web en Render.
# VOLTA_API_URL=https://volta-api.onrender.com
# VOLTA_ORGANIZATION_ID=textiles-pacifico
# VOLTA_DASHBOARD_USER_ID=volta-dashboard
# En Render, PUBLIC_BASE_URL/PUBLIC_WS_URL se infieren de RENDER_EXTERNAL_URL si no se definen.

# Modelo que transcribe al interlocutor. whisper-1 corre como pasada aparte al
# terminar cada turno y por eso el floor va detras de la llamada.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Cuanto tiempo tiene la consola para aceptar una llamada que el agente ofrece.
# Con 5s la oferta vence antes de que nadie alcance a hacer clic.
TAKEOVER_WINDOW_SECONDS=45
